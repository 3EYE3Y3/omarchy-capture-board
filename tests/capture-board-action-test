#!/bin/bash

set -uo pipefail

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly PROJECT_ROOT
TEST_ROOT=$(/usr/bin/mktemp -d /tmp/capture-board-test.XXXXXXXXXX)
readonly TEST_ROOT
readonly FIXTURE_ROOT="$TEST_ROOT/fixture"
readonly MOCK_BIN="$FIXTURE_ROOT/mock-bin"
readonly ACTION="$FIXTURE_ROOT/capture-board-action"
readonly HELPER="$FIXTURE_ROOT/capture-board-paste-text"
readonly PAYLOAD="$TEST_ROOT/payload"
readonly TYPED="$TEST_ROOT/typed"
readonly WTYPE_ARGV="$TEST_ROOT/wtype-argv"
readonly WL_PASTE_ARGV="$TEST_ROOT/wl-paste-argv"
readonly NOTIFICATIONS="$TEST_ROOT/notifications"

tests_run=0

cleanup() {
  /usr/bin/rm -rf -- "$TEST_ROOT"
}

fail() {
  printf 'not ok %d - %s\n' "$tests_run" "$1" >&2
  exit 1
}

pass() {
  printf 'ok %d - %s\n' "$tests_run" "$1"
}

begin_test() {
  tests_run=$((tests_run + 1))
  /usr/bin/rm -f -- "$PAYLOAD" "$TYPED" "$WTYPE_ARGV" "$WL_PASTE_ARGV" "$NOTIFICATIONS"
  : >"$PAYLOAD"
  export MOCK_MIME='text/plain;charset=utf-8'
  export MOCK_LIST_STATUS=0
  export MOCK_DATA_STATUS=0
}

run_action() {
  "$ACTION" paste-plain >"$TEST_ROOT/stdout" 2>"$TEST_ROOT/stderr"
}

assert_files_equal() {
  /usr/bin/cmp -s -- "$1" "$2" || fail "$3"
}

assert_contains() {
  /usr/bin/grep -Fq -- "$2" "$1" || fail "$3"
}

trap cleanup EXIT

/usr/bin/mkdir -p -- "$MOCK_BIN"
/usr/bin/cp -- "$PROJECT_ROOT/bin/capture-board-action" "$ACTION"
/usr/bin/cp -- "$PROJECT_ROOT/bin/capture-board-paste-text" "$HELPER"

cat >"$MOCK_BIN/wl-paste" <<'MOCK'
#!/bin/bash
if [[ ${1:-} == '--list-types' ]]; then
  (( MOCK_LIST_STATUS == 0 )) || exit "$MOCK_LIST_STATUS"
  printf '%s\n' "$MOCK_MIME"
  exit 0
fi
printf '%s\n' "$@" >"$MOCK_WL_PASTE_ARGV"
(( MOCK_DATA_STATUS == 0 )) || exit "$MOCK_DATA_STATUS"
/usr/bin/cat -- "$MOCK_PAYLOAD"
MOCK

cat >"$MOCK_BIN/wtype" <<'MOCK'
#!/bin/bash
printf '%s\n' "$@" >"$MOCK_WTYPE_ARGV"
/usr/bin/cat >"$MOCK_TYPED"
MOCK

cat >"$MOCK_BIN/notify-send" <<'MOCK'
#!/bin/bash
printf '%s\n' "$@" >>"$MOCK_NOTIFICATIONS"
MOCK

/usr/bin/chmod 0755 -- "$ACTION" "$HELPER" "$MOCK_BIN/wl-paste" "$MOCK_BIN/wtype" "$MOCK_BIN/notify-send"
/usr/bin/sed -i \
  -e "s|readonly WL_PASTE=/usr/bin/wl-paste|readonly WL_PASTE=$MOCK_BIN/wl-paste|" \
  -e "s|readonly NOTIFY_SEND=/usr/bin/notify-send|readonly NOTIFY_SEND=$MOCK_BIN/notify-send|" \
  -e 's|/usr/bin/sleep 0.15|/usr/bin/true|' \
  "$ACTION"
/usr/bin/sed -i \
  -e "s|readonly WTYPE=/usr/bin/wtype|readonly WTYPE=$MOCK_BIN/wtype|" \
  "$HELPER"

export MOCK_PAYLOAD="$PAYLOAD"
export MOCK_TYPED="$TYPED"
export MOCK_WTYPE_ARGV="$WTYPE_ARGV"
export MOCK_WL_PASTE_ARGV="$WL_PASTE_ARGV"
export MOCK_NOTIFICATIONS="$NOTIFICATIONS"

begin_test
printf '%s' 'normal short text' >"$PAYLOAD"
run_action || fail 'normal short text returned failure'
assert_files_equal "$PAYLOAD" "$TYPED" 'normal short text changed in transit'
pass 'normal short text'

begin_test
export MOCK_MIME=''
export MOCK_LIST_STATUS=1
run_action || fail 'empty text returned failure'
[[ ! -e $TYPED ]] || fail 'empty text invoked wtype'
[[ ! -e $NOTIFICATIONS ]] || fail 'empty text displayed an error'
pass 'empty clipboard is a no-op'

begin_test
/usr/bin/head -c 262144 /dev/zero | /usr/bin/tr '\0' B >"$PAYLOAD"
run_action || fail 'maximum-sized text returned failure'
assert_files_equal "$PAYLOAD" "$TYPED" 'maximum-sized text changed in transit'
pass 'text at the 256 KiB boundary is accepted'

begin_test
/usr/bin/head -c 262145 /dev/zero | /usr/bin/tr '\0' A >"$PAYLOAD"
if run_action; then
  fail 'oversized text was accepted'
fi
[[ ! -e $TYPED ]] || fail 'oversized text invoked wtype'
assert_contains "$TEST_ROOT/stderr" 'maximum 256 KiB' 'oversized text lacked a useful error'
pass 'oversized text is rejected before typing'

begin_test
export MOCK_MIME='image/png'
printf '%s' 'not really image data' >"$PAYLOAD"
if run_action; then
  fail 'non-text clipboard was accepted'
fi
[[ ! -e $TYPED ]] || fail 'non-text clipboard invoked wtype'
[[ ! -e $WL_PASTE_ARGV ]] || fail 'non-text clipboard payload was requested'
assert_contains "$TEST_ROOT/stderr" 'does not contain plain text' 'non-text clipboard lacked a useful error'
pass 'non-text clipboard is rejected before payload retrieval'

begin_test
marker="$TEST_ROOT/metacharacter-executed"
{
  printf '%s\n' 'spaces  "double quotes"  and '\''single quotes'\'''
  printf '%s\n' "literal shell text: ; | & > < \$(touch $marker)"
  printf '%s' 'AWS_SECRET_ACCESS_KEY=super-secret-example-value'
} >"$PAYLOAD"
run_action || fail 'special text returned failure'
assert_files_equal "$PAYLOAD" "$TYPED" 'spaces, quotes, newlines, or metacharacters changed'
[[ ! -e $marker ]] || fail 'shell metacharacters were executed'
assert_contains "$WTYPE_ARGV" '-' 'wtype was not told to read stdin'
[[ $(/usr/bin/wc -l <"$WTYPE_ARGV") -eq 1 ]] || fail 'wtype received unexpected arguments'
if /usr/bin/grep -Fq 'super-secret-example-value' "$WTYPE_ARGV" "$WL_PASTE_ARGV"; then
  fail 'secret-like clipboard plaintext appeared in child argv'
fi
pass 'special and secret-like text stays exact and out of argv'

begin_test
printf '\377invalid' >"$PAYLOAD"
if run_action; then
  fail 'invalid UTF-8 was accepted'
fi
[[ ! -e $TYPED ]] || fail 'invalid UTF-8 invoked wtype'
assert_contains "$TEST_ROOT/stderr" 'not valid UTF-8' 'invalid UTF-8 lacked a useful error'
pass 'invalid UTF-8 text is rejected before typing'

begin_test
/usr/bin/mv -- "$HELPER" "$HELPER.missing"
printf '%s' 'text' >"$PAYLOAD"
if run_action; then
  fail 'missing helper was accepted'
fi
assert_contains "$TEST_ROOT/stderr" 'paste helper is unavailable' 'missing helper lacked a useful error'
/usr/bin/mv -- "$HELPER.missing" "$HELPER"
pass 'missing trusted helper fails cleanly'

begin_test
/usr/bin/mv -- "$HELPER" "$HELPER.real"
/usr/bin/ln -s -- "$MOCK_BIN/wtype" "$HELPER"
if run_action; then
  fail 'helper symlink outside the plugin was accepted'
fi
assert_contains "$TEST_ROOT/stderr" 'paste helper is unavailable' 'untrusted helper lacked a useful error'
/usr/bin/rm -f -- "$HELPER"
/usr/bin/mv -- "$HELPER.real" "$HELPER"
pass 'helper identity cannot escape the plugin directory'

begin_test
/usr/bin/mv -- "$MOCK_BIN/wtype" "$MOCK_BIN/wtype.missing"
printf '%s' 'text' >"$PAYLOAD"
if run_action; then
  fail 'missing wtype was accepted'
fi
assert_contains "$TEST_ROOT/stderr" 'keyboard input helper' 'missing wtype lacked a useful error'
/usr/bin/mv -- "$MOCK_BIN/wtype.missing" "$MOCK_BIN/wtype"
pass 'missing trusted wtype fails cleanly'

begin_test
/usr/bin/mv -- "$MOCK_BIN/wl-paste" "$MOCK_BIN/wl-paste.missing"
if run_action; then
  fail 'missing wl-paste was accepted'
fi
assert_contains "$TEST_ROOT/stderr" 'clipboard reader' 'missing wl-paste lacked a useful error'
/usr/bin/mv -- "$MOCK_BIN/wl-paste.missing" "$MOCK_BIN/wl-paste"
pass 'missing trusted wl-paste fails cleanly'

printf '1..%d\n' "$tests_run"
